jdbc.uri=
jdbc.username=
jdbc.password=
server.port=
# 127.0.0.1 = only reachable from this machine (production behind a reverse proxy), empty = every interface
server.host=
# true only when the app runs behind a reverse proxy (client ip is read from X-Forwarded-For)
server.trust-proxy=false

# Base64 encoded secret for signing JWT (at least 256 bit)
jwt.secret=
jwt.access.ttl-minutes=15
jwt.refresh.ttl-days=7

# First admin account, only used when there is no admin in the database yet.
# Remove admin.password after the first start.
# When admin.password is empty, a random password is printed once in the log.
admin.username=
admin.password=
